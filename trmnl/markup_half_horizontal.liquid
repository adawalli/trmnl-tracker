{% comment %}
TRMNL Order Queue Tracker - HALF HORIZONTAL view (800x240).
Paste into the plugin's "Half horizontal" markup tab.
Derived metrics (orders_ahead, orders_behind, pct_ahead) are defined in trmnl/shared.liquid.
{% endcomment %}

<div class="layout layout--col gap--space-between">
  <div class="markdown gap--small">
    <span class="title title--small">TRMNL Queue</span>
    <span class="label label--small">Order #{{ order_number }}</span>
  </div>

  <div class="columns">
    <div class="column">
      <div class="content">
        <span class="value value--large" data-value-type="number">{{ orders_ahead }}</span>
        <span class="label">Orders ahead</span>
      </div>
    </div>
    <div class="column">
      <div class="content">
        <span class="value value--large">{{ pct_ahead | round: 1 }}%</span>
        <span class="label">Of queue ahead</span>
      </div>
    </div>
  </div>

  <div class="progress">
    <div class="progress-bar progress-bar--large progress-bar--emphasis-3">
      <div class="track">
        <div class="fill" style="width: {{ pct_ahead }}%;"></div>
      </div>
    </div>
    <div class="flex flex--between">
      <span class="label label--small">{{ orders_ahead | number }} ahead</span>
      <span class="label label--small">{{ orders_behind | number }} behind</span>
    </div>
  </div>
</div>
