{% comment %}
TRMNL Order Queue Tracker - HALF VERTICAL view (400x480).
Paste into the plugin's "Half vertical" markup tab.
Derived metrics (orders_ahead, orders_behind, pct_ahead) are defined in trmnl/shared.liquid.
{% endcomment %}

<div class="layout layout--col gap--space-between">
  <div class="markdown gap--small">
    <span class="title title--small lg:title--base">TRMNL Queue</span>
    <span class="label lg:label--large">Order #{{ order_number }}</span>
  </div>

  <div class="content">
    <span class="value value--xlarge lg:value--xxlarge" data-value-type="number">{{ orders_ahead }}</span>
    <span class="label lg:label--large">Orders ahead of you</span>
  </div>

  <div class="content">
    <span class="value value--large lg:value--xlarge">{{ pct_ahead | round: 1 }}%</span>
    <span class="label lg:label--large">Of queue ahead</span>
  </div>

  <div class="content">
    <span class="value value--medium lg:value--large" data-value-type="number">{{ outstanding_orders }}</span>
    <span class="label lg:label--large">Total outstanding</span>
  </div>

  <div class="stretch-x">
    <div class="progress-bar progress-bar--large progress-bar--emphasis-3">
      <div class="track">
        <div class="fill" style="width: {{ pct_ahead }}%;"></div>
      </div>
    </div>
    <div class="flex flex--between">
      <span class="label label--small lg:label--large">{{ orders_ahead | number }} ahead</span>
      <span class="label label--small lg:label--large">{{ orders_behind | number }} behind</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">Order Queue</span>
  <span class="instance">Updated {{ updated_at | date: "%b %-d, %-I:%M %P" }}</span>
</div>
