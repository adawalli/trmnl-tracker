{% comment %}
TRMNL Order Queue Tracker - HALF VERTICAL view (400x480).
Paste into the plugin's "Half vertical" markup tab.
Derived metrics (orders_ahead, orders_behind, pct_ahead) are defined in trmnl/shared.liquid.
{% endcomment %}

<div class="layout layout--col gap--large">
  <div class="markdown gap--small">
    <span class="title title--small">TRMNL Queue</span>
    <span class="label">Order #{{ order_number }}</span>
  </div>

  <div class="content">
    <span class="value value--large" data-value-fit="true">{{ orders_ahead | number }}</span>
    <span class="label">Orders ahead of you</span>
  </div>

  <div class="content">
    <span class="value value--large" data-value-fit="true">{{ pct_ahead | round: 1 }}%</span>
    <span class="label">Of queue ahead</span>
  </div>

  <div class="content">
    <span class="value value--large" data-value-fit="true">{{ outstanding_orders | number }}</span>
    <span class="label">Total outstanding</span>
  </div>

  <div class="progress">
    <div class="progress-bar progress-bar--small progress-bar--emphasis-3">
      <div class="track">
        <div class="fill" style="width: {{ pct_ahead }}%;"></div>
      </div>
    </div>
    <div class="flex flex--between">
      <span class="label label--small">{{ orders_ahead | number }} ahead</span>
      <span class="label label--small">{{ orders_behind | number }} behind</span>
    </div>
  </div>
</div>
