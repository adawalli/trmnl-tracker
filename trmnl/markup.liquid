{% comment %}
Markup for the TRMNL Order Queue Tracker private plugin (FULL view).
Paste into the plugin's Markup tab in your TRMNL dashboard.
Merge variables come from scripts/poll-order-queue.ts.

Iterate locally: `bun run preview:trmnl` then open http://localhost:3937.
{% endcomment %}

{% assign pct = queue | times: 100.0 | divided_by: outstanding_orders %}
{% assign pct_done = 100.0 | minus: pct %}

<div class="layout layout--col gap--large">

  <div class="columns">
    <div class="column">
      <div class="markdown gap--small">
        <span class="title title--small">TRMNL Order Tracker</span>
        <span class="label">Order #{{ order_number }}</span>
      </div>
    </div>
  </div>

  <div class="grid grid--cols-3">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large" data-value-fit="true">{{ queue | number }}</span>
        <span class="label">Queue position</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large" data-value-fit="true">{{ outstanding_orders | number }}</span>
        <span class="label">Total outstanding</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large" data-value-fit="true">{{ pct_done | round: 1 }}%</span>
        <span class="label">Through the queue</span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="columns">
    <div class="column">
      <div style="width: 100%; height: 24px; background: #e5e5e5; border-radius: 4px; overflow: hidden;">
        <div style="width: {{ pct_done }}%; height: 100%; background: #111;"></div>
      </div>
      <div style="display: flex; justify-content: space-between; margin-top: 4px;">
        <span class="label label--small">{{ outstanding_orders | minus: queue }} shipped</span>
        <span class="label label--small">{{ queue }} remaining</span>
      </div>
    </div>
  </div>

</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">Order Queue</span>
  <span class="instance">Updated {{ updated_at | date: "%b %-d, %-I:%M %P" }}</span>
</div>
