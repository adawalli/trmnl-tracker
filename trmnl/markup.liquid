{% comment %}
Markup for the TRMNL Order Queue Tracker private plugin (FULL view).
Paste into the plugin's "Full" markup tab in your TRMNL dashboard.
Merge variables come from src/worker.ts (production polling) or
scripts/poll-order-queue.ts (manual webhook). Derived metrics are
defined in trmnl/shared.liquid.

Iterate locally: `bun run preview:trmnl` then open http://localhost:3937.
{% endcomment %}

<div class="layout layout--col gap--large lg:gap--xlarge">

  <div class="columns">
    <div class="column">
      <div class="markdown gap--small">
        <span class="title title--small lg:title--base">TRMNL Order Tracker</span>
        <span class="label lg:label--large">Order #{{ order_number }}</span>
      </div>
    </div>
  </div>

  <div class="grid grid--cols-3 lg:gap--xlarge portrait:grid--cols-1 portrait:gap--large lg:portrait:gap--xlarge">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large lg:value--xxlarge" data-value-fit="true">{{ orders_ahead | number }}</span>
        <span class="label lg:label--large">Orders ahead of you</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large lg:value--xlarge" data-value-fit="true">{{ outstanding_orders | number }}</span>
        <span class="label lg:label--large">Total outstanding</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large lg:value--xlarge" data-value-fit="true">{{ pct_ahead | round: 1 }}%</span>
        <span class="label lg:label--large">Of queue ahead</span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="stretch-x">
    <div class="progress-bar progress-bar--large progress-bar--emphasis-3">
      <div class="track">
        <div class="fill" style="width: {{ pct_ahead }}%;"></div>
      </div>
    </div>
    <div class="flex flex--between">
      <span class="label label--small lg:label--large">{{ orders_ahead | number }} ahead</span>
      <span class="label label--small lg:label--large">{{ orders_behind | number }} behind</span>
    </div>
  </div>

</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">Order Queue</span>
  <span class="instance">Updated {{ updated_at | date: "%b %-d, %-I:%M %P" }}</span>
</div>
