{% comment %}
TRMNL Order Queue Tracker - QUADRANT view (400x240).
Paste into the plugin's "Quadrant" markup tab.
Derived metrics (orders_ahead, pct_ahead) are defined in trmnl/shared.liquid.
{% endcomment %}

<div class="layout layout--col gap--small lg:gap--large">
  <div class="markdown gap--small">
    <span class="label lg:label--large">Order #{{ order_number }}</span>
  </div>
  <div class="content">
    <span class="value value--large lg:value--xlarge" data-value-fit="true">{{ orders_ahead | number }}</span>
    <span class="label lg:label--large">Orders ahead of you</span>
  </div>
  <div class="content">
    <span class="label label--small lg:label--large">{{ pct_ahead | round: 0 }}% of queue ahead · {{ outstanding_orders | number }} total</span>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">Order Queue</span>
  <span class="instance">Updated {{ updated_at | date: "%b %-d, %-I:%M %P" }}</span>
</div>
